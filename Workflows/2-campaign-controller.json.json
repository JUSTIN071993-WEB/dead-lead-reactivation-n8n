      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "=customKey",
        "sessionKey": "={{ $json.sessionId }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [
        816,
        272
      ],
      "id": "1cf22aae-bb5b-4c82-8d98-716ee7696a2f",
      "name": "Postgres Chat Memory",
      "credentials": {
        "postgres": {
          "id": "XMsiI3y2vZcn0CdC",
          "name": "Supabase DBR"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH m AS (\n  INSERT INTO messages (lead_id, channel, direction, body, ai_generated)\n  VALUES ($1::uuid, $3::text, 'outbound', $2::text, true)\n  RETURNING id\n), e AS (\n  INSERT INTO lead_events (lead_id, event_type, payload)\n  VALUES ($1::uuid, 'opener_sent', jsonb_build_object('segment', $4::text))\n  RETURNING id\n)\nUPDATE leads\nSET status = 'contacted',\n    last_outbound_at = now(),\n    followup_count = 0,\n    next_action_at = now() + make_interval(days => (SELECT followup_days[1] FROM segment_playbook WHERE segment = $4::text)),\n    updated_at = now()\nWHERE id = $1::uuid\nRETURNING id, $2::text AS opener;",
        "options": {
          "queryReplacement": "={{ [ $('Lead Context').item.json.lead_id, $json.output.replace(/```(json|text)?/gi, '').trim() + \"\\n\\nReply STOP to opt out.\", $('Lead Context').item.json.channel, $('Lead Context').item.json.segment ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1024,
        32
      ],
      "id": "fe0bb483-7c5b-44ec-acfc-f1389ba2b53f",
      "name": "Save Opener",
      "credentials": {
        "postgres": {
          "id": "XMsiI3y2vZcn0CdC",
          "name": "Supabase DBR"
        }
      }
    },
    {
      "parameters": {

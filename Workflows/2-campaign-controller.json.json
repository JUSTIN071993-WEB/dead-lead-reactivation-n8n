    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET status = 'queued', updated_at = now()\nWHERE id = $1::uuid AND is_demo AND status = 'segmented'\nRETURNING id AS lead_id, first_name, segment, service_interest, last_stage, lost_reason,\n          channel_pref AS channel, phone, email,\n          (SELECT angle FROM segment_playbook p WHERE p.segment = leads.segment) AS angle,\n          (SELECT business_name FROM campaign_settings WHERE id = 1) AS business_name,\n          (SELECT sender_name FROM campaign_settings WHERE id = 1) AS sender_name;",
        "options": {
          "queryReplacement": "={{ [ $('Start Demo Lead').item.json.body.lead_id ] }}"
        }
      },

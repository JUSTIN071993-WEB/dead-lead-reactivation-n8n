    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH m AS (\n  INSERT INTO messages (lead_id, channel, direction, body)\n  VALUES ($1::uuid, 'sms', 'inbound', $2)\n  RETURNING id\n)\nUPDATE leads\nSET last_inbound_at = now(),\n    status = CASE WHEN status IN ('booked','human_takeover','opted_out')\n                  THEN status ELSE 'replied' END,\n    updated_at = now()\nWHERE id = $1::uuid\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook').item.json.body.lead_id, $('Webhook').item.json.body.message ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",

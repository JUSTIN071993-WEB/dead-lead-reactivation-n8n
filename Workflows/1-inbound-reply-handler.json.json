    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Returns the next available free consultation time slots (label in Eastern Time, plus starts_at). Call this whenever the lead wants to book, asks about availability, or asks when they can come in. Takes no input.",
        "operation": "executeQuery",
        "query": "WITH days AS (\n  SELECT ((now() AT TIME ZONE 'America/New_York')::date + n) AS day\n  FROM generate_series(1, 14) n\n  WHERE extract(isodow FROM (now() AT TIME ZONE 'America/New_York')::date + n) < 6\n  ORDER BY n\n  LIMIT 5\n),\nslots AS (\n  SELECT ((day + make_time(h, 0, 0)) AT TIME ZONE 'America/New_York') AS starts_at\n  FROM days, generate_series(10, 16) h\n)\nSELECT to_char(starts_at AT TIME ZONE 'America/New_York', 'Dy Mon DD \"at\" HH12:MI AM') AS label,\n       starts_at\nFROM slots s\nWHERE NOT EXISTS (\n  SELECT 1 FROM bookings b WHERE b.status = 'scheduled' AND b.starts_at = s.starts_at\n)\nORDER BY starts_at\nLIMIT 12;",
        "options": {}
      },
